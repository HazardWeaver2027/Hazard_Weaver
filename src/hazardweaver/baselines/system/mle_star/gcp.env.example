# GCP credentials for official MLE-STAR (Vertex / google.auth.default).
# Copy to closedAPI/gcp.env and fill in PI-approved values. Do not commit secrets.
#
#   cp experiments/benchmark/baselines/system/mle_star/gcp.env.example closedAPI/gcp.env
#
export GOOGLE_APPLICATION_CREDENTIALS="closedAPI/your-service-account.json"
export GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
export GOOGLE_CLOUD_LOCATION="us-central1"

# Optional overrides (vendor defaults ROOT_AGENT_MODEL=gemini-2.5-flash)
# export ROOT_AGENT_MODEL="gemini-2.5-flash"
